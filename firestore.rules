rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)); }
    function systemAdmin() { return signedIn() && profile().data.active == true && profile().data.role == "System Admin"; }
    function engineer() { return signedIn() && profile().data.active == true && (profile().data.role == "Engineer" || profile().data.role == "System Admin"); }
    function activeUser() { return signedIn() && profile().data.active == true; }

    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || engineer());
      allow create: if systemAdmin() || (engineer() && request.resource.data.role == "Data Clerk");
      allow update: if systemAdmin()
        || (engineer() && resource.data.role == "Data Clerk" && request.resource.data.role == "Data Clerk")
        || (request.auth.uid == uid
          && activeUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword"])
          && request.resource.data.mustChangePassword == false);
      allow delete: if false;
    }
    match /entries/{id} {
      allow read, create: if activeUser();
      allow update: if activeUser() && (engineer() || resource.data.status == "OPEN");
      allow delete: if false;
    }
    match /vehicles/{id} { allow read, create, update: if activeUser(); allow delete: if false; }
    match /drivers/{id} { allow read, create, update: if activeUser(); allow delete: if false; }
    match /auditEvents/{id} { allow create: if activeUser(); allow read: if systemAdmin(); allow update, delete: if false; }
    match /offlineDiagnostics/{id} { allow read, create, delete: if systemAdmin(); allow update: if false; }
  }
}
